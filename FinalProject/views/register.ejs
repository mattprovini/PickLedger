<!DOCTYPE html>
<html>

<head>
<title>Register - PickLedger</title>
<link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

<div class="navbar">

<a href="/" class="logo-link">
	<img src="/images/logo.png" alt="PickLedger Logo" class="logo-img">
</a>

<div class="nav-links">
<a href="/">Home</a>
<a href="/login">Login</a>
<a href="/register">Register</a>
</div>
</div>
<div class="container">

<h1>Create Account</h1>
<p class="subtitle">Sign up to start tracking your bets.</p>

<div class="card">

<form id="registerForm">

<input type="text" id="username" placeholder="Username" required>
<input type="email" id="email" placeholder="Email" required>
<input type="password" id="password" placeholder="Password" required>
<button type="submit">Register</button>

</form>
<script>
document.getElementById('registerForm').addEventListener('submit', async (e) => {
	e.preventDefault()
		
	const data = {
		username: document.getElementById('username').value,
		email: document.getElementById('email').value,
		password: document.getElementById('password').value
	};
	
	console.log("Sending:", data);
		
	const res = await fetch('http://192.168.56.104:3000/api/register', {
		method: 'POST',
		headers: { 'Content-Type': 'application/json' },
		body: JSON.stringify(data)
	});

	const result = await res.json();
	if(result.message === "User created") {
		window.location.href = "/login";
	} else {
		alert(result.message);
	}
});
</script>

</div>
</div>
</body>
</html>
